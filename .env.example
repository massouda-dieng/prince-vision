# ─── Copier ce fichier en .env et remplir les valeurs ───────────────────────

# Clé secrète Django (générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-REMPLACER-PAR-UNE-VRAIE-CLE

# Mode debug (False en production !)
DEBUG=False

# Hôtes autorisés
ALLOWED_HOSTS=*.vercel.app,localhost,127.0.0.1

# Origines CSRF de confiance (mettre votre vrai domaine Vercel)
CSRF_TRUSTED_ORIGINS=https://VOTRE-PROJET.vercel.app

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Obtenu depuis Vercel Postgres ou Neon.tech
DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Cloudinary (pour les photos uploadées via l'admin) ──────────────────────
# Compte gratuit sur cloudinary.com
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
